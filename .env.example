# ==============================================================================
# AMRS Environment Variables (.env.example)
# Copy to .env.local (or set in your cloud provider's dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service (FastAPI) Configuration
# ------------------------------------------------------------------------------
# Internal port for FastAPI service (default: 8000)
PORT=8000

# Path to SQLite database file
AMRS_DB_PATH=data/amrs.db

# Storage roots for recovery artifacts and uploaded models
AMRS_ARTIFACTS_ROOT=artifacts
AMRS_UPLOADS_ROOT=uploads
AMRS_ALLOW_UPLOAD=1
AMRS_MAX_UPLOAD_BYTES=209715200

# Allowed CORS origins for browser/client requests (comma-separated, or * for open)
# In production, set to your frontend domain: e.g. https://your-amrs-app.vercel.app
AMRS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Service (Next.js) Configuration
# ------------------------------------------------------------------------------
# Server-only proxy URL to the backend service. Never exposed to browser JavaScript.
# Local dev: http://127.0.0.1:8000
# Docker compose: http://api:8000
# Production on Vercel: https://your-backend-service.onrender.com
AMRS_API_INTERNAL_URL=http://127.0.0.1:8000

# Public URL of the frontend application
# e.g. https://your-amrs-app.vercel.app or http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AMRS_APP_NAME=AMRS

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & Profiles)
# Obtain from your Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
