# AMRS gitignore
artifacts/
*.pt
__pycache__/
.venv/
*.db
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
.coverage
htmlcov/

# next.js & web
.next/
out/
/build

# misc
.DS_Store
*.pem
/uploads/*
!/uploads/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
