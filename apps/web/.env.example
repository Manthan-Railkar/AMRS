# ==============================================================================
# AMRS Web Frontend Environment Variables (.env.example)
# ==============================================================================

# Server-only URL to the backend service. Never exposed to browser JavaScript.
# Local dev: http://127.0.0.1:8000
# Docker compose: http://api:8000
# Production on Vercel: https://your-backend-service.onrender.com
AMRS_API_INTERNAL_URL=http://127.0.0.1:8000

# Public URL of the frontend application (used for OAuth redirects)
# e.g. https://your-amrs-app.vercel.app or http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AMRS_APP_NAME=AMRS

# Supabase Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
